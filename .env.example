# ---- Lares server ----
LARES_PORT=8686
LARES_HOST=0.0.0.0
# Thư mục dữ liệu (SQLite, secret key, staging migration). Mặc định: ./data (dev) hoặc /var/lib/lares (production)
LARES_DATA_DIR=
# Khoá bí mật dùng ký JWT và mã hoá thông tin đăng nhập VPS nguồn. Bỏ trống = tự sinh & lưu vào DATA_DIR/secret.key
LARES_SECRET=
# Tài khoản admin lần chạy đầu (nếu bỏ trống mật khẩu sẽ được sinh ngẫu nhiên và in ra log)
LARES_ADMIN_USER=admin
LARES_ADMIN_PASSWORD=

# 1 = chỉ ghi log các lệnh thay đổi hệ thống (nginx, mysql, chown...) thay vì chạy thật.
# Bỏ trống = tự động: bật trên macOS/Windows (dev), tắt trên Linux. install.sh tự đặt 0 trên VPS.
LARES_DRY_RUN=
# Ngôn ngữ mặc định của panel (log khi khởi động, CLI, nội dung Lares ghi lên site): vi | en
# Panel default language (startup logs, CLI, text Lares writes onto sites): vi | en
LARES_LANG=vi

# ---- Web stack trên máy Lares ----
# Để trống/comment khi dev: Lares tự dùng thư mục trong DATA_DIR. Giá trị production do install.sh ghi vào /etc/lares/lares.env
# LARES_SITES_ROOT=/var/www
# LARES_NGINX_AVAILABLE=/etc/nginx/sites-available
# LARES_NGINX_ENABLED=/etc/nginx/sites-enabled
# LARES_PHP_FPM_SOCKET=/run/php/php{version}-fpm.sock
LARES_DEFAULT_PHP=8.2
# LARES_WEB_USER=www-data

# ---- MySQL/MariaDB quản trị (tài khoản có quyền CREATE DATABASE/USER) ----
LARES_MYSQL_HOST=localhost
LARES_MYSQL_PORT=3306
# LARES_MYSQL_SOCKET=/run/mysqld/mysqld.sock
LARES_MYSQL_USER=root
LARES_MYSQL_PASSWORD=

# ---- HTTPS cho trang quản trị (install.sh tự tạo chứng chỉ tự ký) ----
LARES_TLS_CERT=
LARES_TLS_KEY=

# ---- Bảo mật / Security ----
# Tin header X-Forwarded-For từ proxy nào (để trống = không tin). 1|true = mọi proxy, hoặc danh sách IP/CIDR.
# Trust X-Forwarded-For from these proxies (empty = none). 1|true = any, or a comma list of IPs/CIDRs.
LARES_TRUST_PROXY=

# ---- Sao lưu / Backups ----
# Thư mục lưu bản sao lưu site (mặc định /var/backups/lares) / Site backup root (default /var/backups/lares)
# LARES_BACKUP_DIR=/var/backups/lares

# ---- Cập nhật & thống kê ẩn danh / Updates & anonymous stats ----
# 0 = không kiểm tra bản mới trên GitHub / 0 = do not check GitHub for new versions
# LARES_UPDATE_CHECK=1
# 0 = tắt ping ẩn danh (xem README) / 0 = disable the anonymous ping (see README)
# LARES_TELEMETRY=1
