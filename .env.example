# ---- TPanel server ----
TPANEL_PORT=8686
TPANEL_HOST=0.0.0.0
# Thư mục dữ liệu (SQLite, secret key, staging migration). Mặc định: ./data (dev) hoặc /var/lib/tpanel (production)
TPANEL_DATA_DIR=
# Khoá bí mật dùng ký JWT và mã hoá thông tin đăng nhập VPS nguồn. Bỏ trống = tự sinh & lưu vào DATA_DIR/secret.key
TPANEL_SECRET=
# Tài khoản admin lần chạy đầu (nếu bỏ trống mật khẩu sẽ được sinh ngẫu nhiên và in ra log)
TPANEL_ADMIN_USER=admin
TPANEL_ADMIN_PASSWORD=

# 1 = chỉ ghi log các lệnh thay đổi hệ thống (nginx, mysql, chown...) thay vì chạy thật.
# Bỏ trống = tự động: bật trên macOS/Windows (dev), tắt trên Linux. install.sh tự đặt 0 trên VPS.
TPANEL_DRY_RUN=

# ---- Web stack trên máy TPanel ----
# Để trống/comment khi dev: TPanel tự dùng thư mục trong DATA_DIR. Giá trị production do install.sh ghi vào /etc/tpanel/tpanel.env
# TPANEL_SITES_ROOT=/var/www
# TPANEL_NGINX_AVAILABLE=/etc/nginx/sites-available
# TPANEL_NGINX_ENABLED=/etc/nginx/sites-enabled
# TPANEL_PHP_FPM_SOCKET=/run/php/php{version}-fpm.sock
TPANEL_DEFAULT_PHP=8.2
# TPANEL_WEB_USER=www-data

# ---- MySQL/MariaDB quản trị (tài khoản có quyền CREATE DATABASE/USER) ----
TPANEL_MYSQL_HOST=localhost
TPANEL_MYSQL_PORT=3306
# TPANEL_MYSQL_SOCKET=/run/mysqld/mysqld.sock
TPANEL_MYSQL_USER=root
TPANEL_MYSQL_PASSWORD=

# ---- HTTPS cho trang quản trị (install.sh tự tạo chứng chỉ tự ký) ----
TPANEL_TLS_CERT=
TPANEL_TLS_KEY=
